# Talk to @BotFather -> /newbot -> copy the token here.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Your own user id, a group id (negative) or a channel (@channelname).
# Run `uv run tg-notify chat-id` after messaging your bot to discover it.
TELEGRAM_CHAT_ID=987654321

# --- everything below is optional ---

# Forum/topic id, when the target group uses topics.
# TELEGRAM_MESSAGE_THREAD_ID=

# HTML (default, most robust) or MarkdownV2.
# TELEGRAM_PARSE_MODE=HTML

# Deliver silently (no sound) by default - handy for chatty cron jobs.
# TELEGRAM_DISABLE_NOTIFICATION=false

# Show link previews. Off by default so notifications stay compact.
# TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=true

# Networking / retry tuning.
# TELEGRAM_TIMEOUT=15
# TELEGRAM_MAX_ATTEMPTS=5
# TELEGRAM_SEND_INTERVAL=0.5
# TELEGRAM_API_BASE=https://api.telegram.org
